rules_version = '2';
// Regras de segurança do Firestore.
// Troque os e-mails abaixo pelos e-mails cadastrados no Authentication.
// Só essas contas conseguem ler e gravar os dados.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['email-do-tiago@gmail.com', 'seu-email@gmail.com'];
    }
  }
}
